# Copy to .env next to compose.yaml. compose refuses to start without TSUKUCHALLE_UID and TSUKUCHALLE_GID.
#
# The uid/gid that every ROS container on the robot runs as. Shared-memory files of Fast DDS belong to the uid that
# made them, so all containers must use the same value: 1000 (the other containers (drive, joy, teleop, velodyne,
# description, gnss) run as uid 1000 too). If one of them still runs as root, use 0 until all of them are changed together
# (tsukuchalle_drivers #19).
# `./data` must belong to this uid, or `localization` cannot write the map: stat -c %u:%g ~/lightnav/data
TSUKUCHALLE_UID=1000
TSUKUCHALLE_GID=1000

# `nav` starts safety_gate_node (the only /cmd_vel publisher of the stack) unless this is false.
# false is only for teaching drives with the gamepad (record_waypoints); never follow waypoints with it.
# Normally leave it unset and pass it for one start: LIGHTNAV_SAFETY_GATE=false docker compose up -d nav
# LIGHTNAV_SAFETY_GATE=true

# params file of localization_node. Unset: /config/robot.yaml (outdoors, with GNSS). Indoors without GNSS (docker/README.md):
# LIGHTNAV_LOCALIZATION_PARAMS=/config/localization_indoor.yaml
