# Copy to .env next to compose.yaml. compose refuses to start without TSUKUCHALLE_UID and TSUKUCHALLE_GID.
#
# The uid/gid that every ROS container on the robot runs as. Shared-memory files of Fast DDS belong to the uid that
# made them, so all containers must use the same value. While the other containers (drive, joy, teleop, velodyne,
# description, gnss) run as root, use 0. Change to 1000 for all of them at the same time (tsukuchalle_drivers #19).
TSUKUCHALLE_UID=0
TSUKUCHALLE_GID=0

# `nav` starts safety_gate_node (the only /cmd_vel publisher of the stack) unless this is false.
# false is only for teaching drives with the gamepad (record_waypoints); never follow waypoints with it.
# Normally leave it unset and pass it for one start: LIGHTNAV_SAFETY_GATE=false docker compose up -d nav
# LIGHTNAV_SAFETY_GATE=true
