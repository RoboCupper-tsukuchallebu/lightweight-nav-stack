<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lightnav_safety_gate</name>
  <version>0.1.0</version>
  <description>Emergency stop, saturation and rate limiting for /cmd_vel</description>
  <maintainer email="maintainers@example.com">lightnav maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>lightnav_msgs</depend>

  <test_depend>ament_cmake_test</test_depend>
  <test_depend>gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
