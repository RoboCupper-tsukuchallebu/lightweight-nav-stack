<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lightnav_bringup</name>
  <version>0.1.0</version>
  <description>Launch file that starts the lightnav nodes on the robot (Docker)</description>
  <maintainer email="maintainers@example.com">lightnav maintainers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>lightnav_controller</exec_depend>
  <exec_depend>lightnav_mission</exec_depend>
  <exec_depend>lightnav_obstacle_monitor</exec_depend>
  <exec_depend>lightnav_planner</exec_depend>
  <exec_depend>lightnav_pose_adapter</exec_depend>
  <exec_depend>lightnav_safety_gate</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
